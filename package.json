{
  "name": "pi-packages",
  "private": true,
  "type": "module",
  "workspaces": [
    "local/*",
    "fork/*"
  ],
  "scripts": {
    "bench:perf": "PI_BIN=./node_modules/.bin/pi node scripts/check-host.mjs env PI_BENCH_NODE=\"$PI_BENCH_NODE\" bun scripts/bench/run.mjs",
    "typecheck": "npm run typecheck --workspaces && tsc -p integration/tsconfig.json",
    "test": "node --test --test-concurrency=1 --test-timeout=300000 scripts/*.test.mjs && node scripts/check-doc-links.mjs && node scripts/isolated-agent.mjs npm run test --workspaces",
    "test:integration": "node integration/run.mjs default",
    "test:integration:side-chat": "node integration/run.mjs side-chat",
    "test:integration:stock-host": "node integration/run.mjs stock-host",
    "test:integration:patched-host": "node integration/run.mjs patched-host",
    "test:integration:subagents": "node integration/run.mjs subagents",
    "check:goal": "node scripts/isolated-agent.mjs npm --prefix fork/pi-goal run check",
    "test:integration:goal": "node integration/run.mjs goal",
    "test:integration:goal-ui": "node integration/run.mjs goal-ui",
    "test:integration:mcp": "node integration/run.mjs mcp",
    "test:integration:search": "node integration/run.mjs search",
    "test:integration:ask": "node integration/run.mjs ask"
  },
  "devDependencies": {
    "@earendil-works/pi-agent-core": "1.5.0",
    "@earendil-works/pi-ai": "1.5.0",
    "@earendil-works/pi-coding-agent": "1.5.0",
    "@earendil-works/pi-tui": "1.5.0",
    "@types/node": "^24.19.2",
    "@types/bun": "1.3.14",
    "@xterm/headless": "6.0.0",
    "entities": "^6.0.1",
    "github-slugger": "^2.0.0",
    "marked": "^18.0.11",
    "typescript": "~5.9.3",
    "@biomejs/biome": "2.5.6",
    "vitest": "5.1.0",
    "tsx": "4.23.15",
    "@types/cross-spawn": "6.0.6",
    "@types/open": "6.2.1"
  }
}
