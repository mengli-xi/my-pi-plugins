{
  "name": "pi-packages",
  "private": true,
  "type": "module",
  "workspaces": [
    "local/*"
  ],
  "scripts": {
    "typecheck": "npm run typecheck --workspaces && tsc -p integration/tsconfig.json",
    "test": "node scripts/isolated-agent.mjs npm run test --workspaces",
    "test:integration": "node scripts/isolated-agent.mjs node --import ./ts-resolve.mjs --experimental-strip-types --test integration/*.test.ts",
    "test:integration:stock-host": "npm run build -w pi-subagents && bun integration/subagent-no-presentation.mjs",
    "test:integration:patched-host": "node integration/run-patched-host.mjs",
    "test:integration:subagents": "npm run build -w pi-subagents && node integration/run-subagents.mjs"
  },
  "devDependencies": {
    "@earendil-works/pi-agent-core": "1.5.0",
    "@earendil-works/pi-ai": "1.5.0",
    "@earendil-works/pi-coding-agent": "1.5.0",
    "@earendil-works/pi-tui": "1.5.0",
    "@types/node": "^24.19.2",
    "typescript": "~5.9.3"
  }
}
