{
	"name": "pi-todo",
  "license": "MIT",
	"version": "0.1.0",
	"description": "Minimal replace-on-write todo tool for the Pi coding agent (Claude Code / Codex style)",
	"type": "module",
	"private": true,
	"keywords": [
		"pi-package",
		"pi-extension",
		"todo"
	],
	"pi": {
		"extensions": [
			"./index.ts"
		]
	},
	"scripts": {
		"typecheck": "tsc --noEmit",
		"test": "node --experimental-transform-types --test tests/*.test.ts",
		"check": "npm run typecheck && npm test"
	},
	"peerDependencies": {
		"@earendil-works/pi-coding-agent": "^1.5.0",
		"@earendil-works/pi-tui": "^1.5.0",
		"typebox": "*"
	},
	"devDependencies": {
		"typebox": "1.3.27"
	}
}
