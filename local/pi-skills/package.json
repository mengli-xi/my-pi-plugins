{
  "name": "pi-skills",
  "version": "0.1.0",
  "description": "Codex-style explicit $skill mentions for Pi",
  "type": "module",
  "private": true,
  "keywords": [
    "pi-package",
    "pi-extension",
    "skills",
    "mentions",
    "codex"
  ],
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --experimental-transform-types --test tests/*.test.ts",
    "check": "npm run typecheck && npm run check:internals && npm test",
    "check:internals": "node ../../scripts/isolated-agent.mjs node scripts/check-internals.mjs",
    "check:host": "node ../../scripts/check-host.mjs node scripts/check-internals.mjs --host"
  },
  "peerDependencies": {
    "@earendil-works/pi-agent-core": "^1.5.0",
    "@earendil-works/pi-coding-agent": "^1.5.0",
    "@earendil-works/pi-tui": "^1.5.0"
  }
}
