{
  "name": "pi-rewind",
  "version": "0.1.0",
  "description": "Destructive single-path rewind for Pi sessions with a linear conversation picker.",
  "type": "module",
  "private": true,
  "keywords": [
    "pi-package",
    "pi-extension",
    "session",
    "rewind"
  ],
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --experimental-transform-types --test tests/*.test.ts",
    "check-internals": "node scripts/check-internals.mjs",
    "check": "npm run typecheck && npm run check-internals && npm test"
  },
  "dependencies": {
    "pi-li-uikit": "file:../pi-li-uikit"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "^1.5.0",
    "@earendil-works/pi-tui": "^1.5.0"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.5.0",
    "@earendil-works/pi-tui": "1.5.0",
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  }
}
