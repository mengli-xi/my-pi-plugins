{
  "name": "pi-terminal-focus",
  "license": "MIT",
  "version": "0.1.0",
  "description": "Hide Pi's main editor cursor when the terminal loses focus.",
  "type": "module",
  "private": true,
  "keywords": [
    "pi-package",
    "pi-extension",
    "terminal",
    "focus",
    "cursor"
  ],
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --experimental-transform-types --test test/*.test.ts",
    "check": "npm run typecheck && npm run check:internals && npm test",
    "check:internals": "node ../../scripts/isolated-agent.mjs node scripts/check-internals.mjs",
    "check:host": "node ../../scripts/check-host.mjs node scripts/check-internals.mjs --host",
    "check:smoke": "npm run check:host"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "^1.5.0",
    "@earendil-works/pi-tui": "^1.5.0"
  }
}
