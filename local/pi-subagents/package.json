{
  "name": "pi-subagents",
  "license": "MIT",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Persistent in-process SDK Subagents for Pi",
  "files": [
    "dist",
    "skills",
    "README.md"
  ],
  "pi": {
    "extensions": [
      "./dist/index.js"
    ],
    "skills": [
      "./skills/subagents"
    ]
  },
  "dependencies": {
    "pi-li-uikit": "^0.1.0",
    "pi-runtime-contracts": "^0.1.0",
    "pi-session-runtime": "^0.1.0",
    "pi-session-inject": "^0.1.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "^1.5.0",
    "@earendil-works/pi-coding-agent": "^1.5.0",
    "@earendil-works/pi-tui": "^1.5.0",
    "typebox": "*",
    "@earendil-works/pi-agent-core": "^1.5.0"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-ai": {
      "optional": true
    },
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "@earendil-works/pi-tui": {
      "optional": true
    },
    "typebox": {
      "optional": true
    },
    "@earendil-works/pi-agent-core": {
      "optional": true
    }
  },
  "devDependencies": {
    "typebox": "1.1.38",
    "@xterm/headless": "^6.0.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "node scripts/build.mjs",
    "verify-dist": "node scripts/verify-dist.mjs",
    "test": "node --import ../../ts-resolve.mjs --experimental-strip-types --test test/unit/*.test.ts test/contract/*.test.ts",
    "check": "npm run typecheck && npm run build && npm run verify-dist && npm test",
    "prepare": "npm run build",
    "test:real": "node ../../scripts/check-build.mjs && node --import ../../ts-resolve.mjs --experimental-strip-types --test test/real/*.test.ts",
    "check:upgrade": "node ../../scripts/check-upgrade.mjs",
    "check:upgrade:real": "node --import ../../ts-resolve.mjs --experimental-strip-types --test --test-timeout=300000 test/real/*.test.ts"
  },
  "engines": {
    "node": ">=20"
  }
}
