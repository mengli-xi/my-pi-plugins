{
  "name": "pi-subagents",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Persistent in-process SDK Subagents for Pi",
  "files": [
    "dist",
    "skills",
    "README.md"
  ],
  "pi": {
    "extensions": [
      "./dist/index.js"
    ],
    "skills": [
      "./skills/subagents"
    ]
  },
  "dependencies": {
    "pi-li-uikit": "^0.1.0",
    "pi-runtime-contracts": "^0.1.0",
    "pi-session-runtime": "^0.1.0",
    "pi-session-inject": "^0.1.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "^1.5.0",
    "@earendil-works/pi-coding-agent": "^1.5.0",
    "@earendil-works/pi-tui": "^1.5.0",
    "typebox": "*",
    "@earendil-works/pi-agent-core": "^1.5.0"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-ai": {
      "optional": true
    },
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "@earendil-works/pi-tui": {
      "optional": true
    },
    "typebox": {
      "optional": true
    },
    "@earendil-works/pi-agent-core": {
      "optional": true
    }
  },
  "devDependencies": {
    "typebox": "1.1.38",
    "@xterm/headless": "^6.0.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "node scripts/build.mjs",
    "verify-dist": "node scripts/verify-dist.mjs",
    "test": "node --import ../../ts-resolve.mjs --experimental-strip-types --test test/unit/*.test.ts test/contract/*.test.ts",
    "test:real-main": "npm run build && node --import ../../ts-resolve.mjs --experimental-strip-types --test test/real/main-binding.test.ts",
    "test:real-spawn": "npm run build && node --import ../../ts-resolve.mjs --experimental-strip-types --test test/real/spawn-e2e.test.ts",
    "test:full-settings": "npm run build && node --import ../../ts-resolve.mjs --experimental-strip-types --test test/real/full-settings-spawn.test.ts",
    "test:real-nested": "npm run build && node --import ../../ts-resolve.mjs --experimental-strip-types --test test/real/nested-e2e.test.ts",
    "test:real-nested-interrupt": "npm run build && node --import ../../ts-resolve.mjs --experimental-strip-types --test test/real/nested-interrupt-e2e.test.ts",
    "test:real-process-child": "npm run build && node --import ../../ts-resolve.mjs --experimental-strip-types --test test/real/process-child-e2e.test.ts test/real/process-watch-late-exit-e2e.test.ts test/real/process-finish-e2e.test.ts",
    "test:real-reload": "npm run build && node --import ../../ts-resolve.mjs --experimental-strip-types --test test/real/reload-e2e.test.ts",
    "test:real-crash": "npm run build && node --import ../../ts-resolve.mjs --experimental-strip-types --test test/real/crash-e2e.test.ts",
    "test:real-session-switch": "npm run build && node --import ../../ts-resolve.mjs --experimental-strip-types --test test/real/session-switch-e2e.test.ts",
    "test:real-quit": "npm run build && node --import ../../ts-resolve.mjs --experimental-strip-types --test test/real/quit-cleanup.test.ts",
    "test:real-mailbox": "npm run build && node --import ../../ts-resolve.mjs --experimental-strip-types --test test/real/mailbox-running-e2e.test.ts test/real/root-mailbox-e2e.test.ts",
    "test:real-followup": "npm run build && node --import ../../ts-resolve.mjs --experimental-strip-types --test test/real/followup-e2e.test.ts",
    "test:real-delivery-order": "npm run build && node --import ../../ts-resolve.mjs --experimental-strip-types --test test/real/completion-tool-order-e2e.test.ts",
    "test:real-main-wake": "npm run build && node --import ../../ts-resolve.mjs --experimental-strip-types --test test/real/main-wake-e2e.test.ts",
    "test:real-unhandled-reopen": "npm run build && node --import ../../ts-resolve.mjs --experimental-strip-types --test test/real/unhandled-reopen-e2e.test.ts",
    "test:real-web-search": "npm run build && node --import ../../ts-resolve.mjs --experimental-strip-types --test test/real/web-search-child-e2e.test.ts",
    "test:real-lifecycle": "npm run test:real-nested && npm run test:real-nested-interrupt && npm run test:real-process-child && npm run test:real-reload && npm run test:real-crash && npm run test:real-session-switch && npm run test:real-quit",
    "check": "npm run typecheck && npm run build && npm run verify-dist && npm test",
    "prepare": "npm run build",
    "test:real": "npm run build && node --import ../../ts-resolve.mjs --experimental-strip-types --test test/real/*.test.ts",
    "test:real-sdk-view": "npm run build && bun test/real/sdk-child-view.mjs",
    "test:real-sdk-statusline": "npm run build && bun test/real/sdk-statusline.mjs",
    "test:real-sdk-initialization": "npm run build && bun test/real/sdk-initialization.mjs"
  },
  "engines": {
    "node": ">=20"
  }
}
