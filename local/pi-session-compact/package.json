{
  "name": "pi-session-compact",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Whole-session compaction and exact session history retrieval for stock Pi 1.5",
  "keywords": [
    "pi-package",
    "pi-extension"
  ],
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --import ../../ts-resolve.mjs --experimental-strip-types --test tests/*.test.ts",
    "check": "npm run typecheck && npm test",
    "test:host": "node scripts/check-host.mjs"
  },
  "dependencies": {
    "jsonc-parser": "^3.3.1",
    "marked": "18.0.11",
    "pi-li-uikit": "^0.1.0",
    "pi-runtime-contracts": "^0.1.0",
    "pi-session-inject": "^0.1.0",
    "pi-session-runtime": "^0.1.0",
    "proper-lockfile": "4.1.2"
  },
  "peerDependencies": {
    "@sinclair/typebox": "*",
    "@earendil-works/pi-ai": "^1.5.0",
    "@earendil-works/pi-coding-agent": "^1.5.0"
  },
  "devDependencies": {
    "@sinclair/typebox": "^0.34.0",
    "@types/proper-lockfile": "4.1.4"
  }
}
