{
  "name": "pi-cc-memory",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Project memory files with bounded persistent Pi system sections",
  "keywords": [
    "pi-package",
    "pi-extension",
    "memory"
  ],
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "check": "npm run typecheck && npm test",
    "check:host": "node ../../scripts/check-host.mjs node scripts/check-host.mjs"
  },
  "dependencies": {
    "pi-li-uikit": "^0.1.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "^1.5.0"
  }
}
