{
  "name": "pi-session-inject",
  "license": "MIT",
  "version": "0.1.0",
  "description": "Pi-aware live session prompt injection primitives shared by pi-scheduler and pi-subagents.",
  "type": "module",
  "private": true,
  "exports": {
    ".": "./src/index.ts",
    "./open-tail-tool-calls-v1": "./src/open-tail-tool-calls-v1.ts",
    "./append-at-safe-boundary-v1": "./src/append-at-safe-boundary-v1.ts",
    "./mailbox-v1": "./src/mailbox-v1/index.ts",
    "./mailbox-v1/schema": "./src/mailbox-v1/schema.ts",
    "./types": "./src/types.ts",
    "./mailbox-v1/light": "./src/mailbox-v1/light.ts"
  },
  "files": [
    "src"
  ],
  "scripts": {
    "test": "node --import ../../ts-resolve.mjs --experimental-strip-types --test test/*.test.ts",
    "test:native": "node test/native/run.mjs && node test/native/cancel-projection.mjs",
    "test:followup": "node test/native/followup.mjs",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test",
    "check:upgrade": "node ../../scripts/check-upgrade.mjs",
    "check:upgrade:native": "node test/native/run.mjs",
    "check:upgrade:cancel": "node test/native/cancel-projection.mjs",
    "check:upgrade:followup": "npm run test:followup",
    "check:smoke": "node ../../scripts/check-host.mjs node test/native/run.mjs :: node test/native/cancel-projection.mjs :: node test/native/followup.mjs"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "^1.5.0"
  },
  "devDependencies": {
    "typebox": "^1.3.27"
  }
}
