{
  "name": "pi-package-manager",
  "version": "0.1.0",
  "description": "A focused TUI for toggling, updating, and inspecting Pi packages",
  "type": "module",
  "private": true,
  "license": "MIT",
  "keywords": [
    "pi-package",
    "pi-extension",
    "package-manager"
  ],
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-transform-types --import ../../ts-resolve.mjs --test tests/*.test.ts",
    "check": "npm run typecheck && npm test"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "^1.5.0",
    "@earendil-works/pi-tui": "^1.5.0"
  },
  "dependencies": {
    "pi-li-uikit": "^0.1.0"
  }
}
