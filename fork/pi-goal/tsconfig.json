{
	"compilerOptions": {
		"target": "ES2022",
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"strict": true,
		"noEmit": true,
		"skipLibCheck": true,
		"types": [
			"node"
		],
		"erasableSyntaxOnly": true,
		"rootDir": ".",
		"allowImportingTsExtensions": true
	},
	"include": [
		"src/**/*.ts"
	]
}
