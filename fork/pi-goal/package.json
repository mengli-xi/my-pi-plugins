{
	"name": "@narumitw/pi-goal",
	"version": "0.48.1",
	"description": "Pi extension for autonomous /goal completion with opt-in experimental ordered queues.",
	"type": "module",
	"license": "MIT",
	"private": false,
	"keywords": [
		"pi-package",
		"pi-extension",
		"pi",
		"goal",
		"queue",
		"automation"
	],
	"files": [
		"src",
		"dist",
		"docs",
		"README.md",
		"LICENSE"
	],
	"pi": {
		"extensions": [
			"./dist/index.js"
		]
	},
	"scripts": {
		"build": "bun build src/index.ts --outdir dist --splitting --target node --format esm --external \"@earendil-works/*\" --external typebox",
		"check": "biome check . && node scripts/check-extension-boundaries.mjs && npm run typecheck && npm test",
		"format": "biome check --write .",
		"test": "node --import ../../ts-resolve.mjs --experimental-strip-types --test test/*.test.ts",
		"test:runtime": "node ./test/goal-runtime-smoke.mjs",
		"test:ui": "bun ./test/goal-ui-e2e.mjs",
		"typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json --allowImportingTsExtensions"
	},
	"dependencies": {
		"@narumitw/pi-tui-kit": "^0.40.0",
		"pi-runtime-contracts": "*",
		"pi-li-uikit": "*",
		"pi-session-inject": "*"
	},
	"peerDependencies": {
		"@earendil-works/pi-ai": "^1.5.0",
		"@earendil-works/pi-coding-agent": "^1.5.0",
		"@earendil-works/pi-tui": "^1.5.0",
		"typebox": "*"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/narumiruna/pi-extensions",
		"directory": "extensions/pi-goal"
	}
}
