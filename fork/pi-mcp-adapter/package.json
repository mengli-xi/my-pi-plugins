{
  "name": "pi-mcp-adapter",
  "version": "7.0.1-local.1",
  "description": "MCP (Model Context Protocol) adapter extension for Pi coding agent",
  "type": "module",
  "types": "./index.ts",
  "exports": {
    ".": {
      "types": "./index.ts",
      "import": "./index.ts",
      "default": "./index.ts"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "import": "./dist/types.js",
      "default": "./dist/types.js"
    },
    "./oauth": {
      "types": "./oauth.ts",
      "import": "./oauth.ts",
      "default": "./oauth.ts"
    },
    "./host-managed": {
      "types": "./host-managed.ts",
      "import": "./host-managed.ts",
      "default": "./host-managed.ts"
    },
    "./config": {
      "types": "./dist/config.d.ts",
      "import": "./dist/config.js",
      "default": "./dist/config.js"
    },
    "./metadata-cache": {
      "types": "./dist/metadata-cache.d.ts",
      "import": "./dist/metadata-cache.js",
      "default": "./dist/metadata-cache.js"
    }
  },
  "license": "MIT",
  "author": "Nico Bailon",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "bin": {
    "pi-mcp-adapter": "cli.js"
  },
  "scripts": {
    "build": "bun scripts/build.mjs",
    "prepack": "npm run build",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:vitest && npm run test:node && npm run test:public-exports",
    "test:node": "node scripts/test-runner.mjs node --experimental-transform-types --test mcp-auth-readonly.test.ts mcp-auth-mailbox.test.ts mcp-auth-request-headers.test.ts secure-keyring.test.ts mailbox-task.test.ts test/path-cache-file.test.ts test/path-cache-profile.test.ts",
    "test:vitest": "node scripts/test-runner.mjs vitest run --config scripts/vitest.config.ts",
    "test:watch": "node scripts/test-runner.mjs vitest --config scripts/vitest.config.ts",
    "test:public-exports": "node ../../scripts/check-build.mjs && node scripts/test-runner.mjs node --test public-exports.test.mjs",
    "check:host": "node ../../scripts/check-host.mjs node ../../scripts/check-build.mjs :: --skip-binary=\"dist 探针必须从 npm 宿主目录 import SDK，并由 Node 执行 CLI\" node scripts/test-runner.mjs node --test dist-host.test.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nicobailon/pi-mcp-adapter.git"
  },
  "keywords": [
    "pi-package",
    "pi",
    "mcp",
    "model-context-protocol",
    "ai",
    "coding-agent",
    "extension",
    "claude",
    "llm"
  ],
  "pi": {
    "extensions": [
      "./dist/index.js"
    ],
    "video": "https://github.com/nicobailon/pi-mcp-adapter/raw/refs/heads/main/pi-mcp.mp4"
  },
