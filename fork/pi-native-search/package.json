{
  "name": "pi-native-search",
  "version": "0.1.0",
  "private": false,
  "description": "Pi web_search and web_fetch tools with public native providers, optional registered backends and DuckDuckGo fallback.",
  "keywords": [
    "pi-package",
    "pi",
    "extension",
    "web-search",
    "web-fetch",
    "glm",
    "duckduckgo"
  ],
  "author": "Salem Malibary <salem.thecreativeconsult@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/smalibary/pi-native-search.git"
  },
  "homepage": "https://github.com/smalibary/pi-native-search#readme",
  "bugs": {
    "url": "https://github.com/smalibary/pi-native-search/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "type": "module",
  "scripts": {
    "test": "node ../../scripts/isolated-agent.mjs node --import ../../ts-resolve.mjs --experimental-strip-types --test test/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "files": [
    "extensions",
    "README.md",
    "LOCAL_PATCHES.md",
    "docs",
    "LICENSE"
  ],
  "dependencies": {
    "pi-runtime-contracts": "^0.1.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "^1.5.0",
    "@earendil-works/pi-tui": "^1.5.0",
    "typebox": "*"
  },
  "pi": {
    "extensions": [
      "./extensions/index.ts"
    ]
  }
}
